@article{landes_trust_2027,
	title = {Trust in {AI} is {Not} a {Conceptual} {Confusion}},
	journal = {Ergo},
	author = {Landes, Ethan and Claessens, Scott and Everett, Jim A. C.},
	year = {2027},
	note = {A rift has opened between philosophical and non-philosophical perspectives on what kind of conceptual stance we can take towards artificial intelligence: are AI-powered machines the sort of things that can be trusted? Outside of philosophy, an ever-increasing body of research is looking at features of AI that promote trust and trustworthiness to understand how and why people “trust” AI. Within philosophy, this entire endeavor is widely seen as resting on a conceptual confusion about trust; trust requires the object of trust having agential capacities that modern AI lacks, and so whatever this body of research is studying, it is not, properly speaking, “trust”. Who is right? To shed light on this question, we explore the extent to which people thought sentences involving trusting different sorts of things make sense. We find that people do think it makes sense to talk about trusting AI, although less than it makes sense to trust other humans – even if they do not think AI has the sort of agential capacities philosophers think are required to be the object of trust. We conclude that either trust does not require agency or that there are multiple senses of trust, and neither conclusion is consistent with “trustworthy AI” being a conceptual confusion. While this undermines one criticism of AI and AI-related stakeholders, it nonetheless does not entail that AI is worthy of our trust.},
	file = {Snapshot:/home/ethan/snap/zotero-snap/common/Zotero/storage/U5EZ57J5/LANTIA-8.html:text/html},
}
